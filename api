from fastapi import FastAPI, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel
from sqlalchemy import event
from sqlalchemy.engine import Engine
from engine import SilnikNawigacji


@event.listens_for(Engine, "connect")
def register_sqlite_postgis_shim(dbapi_connection, connection_record):
    if hasattr(dbapi_connection, "create_function"):
        dbapi_connection.create_function("ST_AsGeoJSON", 1, lambda x: x)


app = FastAPI(title="GIS Routing API")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

DB_URL = "sqlite:///testowa_baza.db"
silnik_nawigacji = None


@app.on_event("startup")
def startup_event():
    global silnik_nawigacji
    silnik_nawigacji = SilnikNawigacji(DB_URL)


class TrasaRequest(BaseModel):
    start_lat: float
    start_lon: float
    meta_lat: float
    meta_lon: float
    algorytm: str = "astar"
    preferencja_turystyczna: float = 0.0


@app.post("/api/wyznacz_trase")
def wyznacz_trase(req: TrasaRequest):
    try:
        start_node = silnik_nawigacji.znajdz_najblizszy_wezel(
            req.start_lon, req.start_lat
        )
        meta_node = silnik_nawigacji.znajdz_najblizszy_wezel(req.meta_lon, req.meta_lat)

        if not start_node or not meta_node:
            raise HTTPException(
                status_code=404,
                detail="Błąd przestrzenny: Nie znaleziono węzłów wejściowych.",
            )

        if req.algorytm == "astar":
            wynik = silnik_nawigacji.astar(
                start_node,
                meta_node,
                preferencja_turystyczna=req.preferencja_turystyczna,
            )
        else:
            wynik = silnik_nawigacji.dijkstra(
                start_node,
                meta_node,
                preferencja_turystyczna=req.preferencja_turystyczna,
            )

        if not wynik or not wynik[0]:
            raise HTTPException(
                status_code=404,
                detail="Brak topologicznej spójności. Nie znaleziono ścieżki.",
            )

        trasa, koszt, mijane_atrakcje_surowe, odwiedzone_wezly = wynik

        wzbogacone_atrakcje = {}
        czas_calkowity_s = 0.0
        for i in range(len(trasa) - 1):
            u = trasa[i]
            v = trasa[i + 1]
            krawedz_policzona = False
            for sasiad, czas_n, mnoznik, atr in silnik_nawigacji.graf.get(u, []):
                if sasiad != v:
                    continue
                if not krawedz_policzona:
                    czas_calkowity_s += czas_n
                    krawedz_policzona = True
                if req.preferencja_turystyczna > 0.0 and atr:
                    for a in atr.split(","):
                        nazwa = a.strip()
                        if nazwa and nazwa not in wzbogacone_atrakcje:
                            lon, lat = silnik_nawigacji.wspolrzedne[v]
                            wzbogacone_atrakcje[nazwa] = {
                                "nazwa": nazwa,
                                "lat": float(lat),
                                "lon": float(lon),
                                "czas_dojazdu_s": round(czas_calkowity_s, 1),
                            }
                    break

        atrakcje_lista = list(wzbogacone_atrakcje.values())

        trasa_geojson = silnik_nawigacji.trasa_na_geojson(trasa)
        trasa_geojson["properties"]["koszt"] = koszt

        return {
            "trasa_geojson": trasa_geojson,
            "metryki": {
                "koszt": koszt,
                "odwiedzone_wezly_zlozonosc": odwiedzone_wezly,
                "czas_calkowity_s": round(czas_calkowity_s, 1),
            },
            "atrakcje": atrakcje_lista,
        }

    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))
